apiVersion: skills.automacene.org/v1alpha1
kind: SemanticSkill
metadata:
  name: multipleinputs
  namespace: standard
  labels:
    automacene.org/version: "1.0.0"
  annotations:
    automacene.org/oasf-name: Email Writer (Multiple Inputs)
    automacene.org/description: Write an email from a prompt, signed by a named sender. A worked example
      of a multi-input skill.
spec:
  authors:
    - Codie Petersen <codie@asteres-technologies.com>
  capabilities:
    skills:
      - name: content_writing_marketing/email_marketing/email_campaign_creation
        id: 110801
  inputs:
    - name: date
      description: Today's date, as it should read in the email.
    - name: name
      description: The sender's name.
    - name: input
      description: What the email should say.
      required: true
  sections:
    - name: instructions
      kind: instructions
      text: |
        Generate an email to the best of your abilities according to the user's prompt. Start all
        emails with:
        Hello "recipient's name",
            Today is "the date".
    - name: date
      kind: context
      text: |
        [context]
        date: {{$date}}
      absent: No date was given. Leave the date line out of the email.
      default: |
        Missing parameters prevented this section from resolving.
    - name: sender
      kind: context
      text: |
        name: "{{$name}}"
      absent: No sender was given. Sign off generically.
      default: |
        Missing parameters prevented this section from resolving.
    - name: examples
      kind: examples
      text: |
        [example context]
        date: 6-7-23
        name: Codie Petersen

        prompt: Please make an email for Jeffery about his appointment with Doctor Henry at 3pm tomorrow.
        steps: Let's identify step by step what we need to do.
        1. Address the recipient "Jeffery"
        - example: Hello Jeffery,
        Today is 6-7-23.
        2. Identify the purpose of your email
        - example: I am writing to remind you that you have an appointment with Doctor Henry at 3pm tomorrow.
        3. Check if the sender has specified relevant information about the appointment.
        - example: They have not.
        4. Closing line
        Let me know if you need any further assistance.
        Best wishes, Codie Petersen
        [email]
        Hello Jeffery,
             Today is 6-7-23. I am writing to remind you that you have an appointment with Doctor Henry at 3pm tomorrow.  Let me know if you need any further assistance.
        Best wishes, Codie Petersen

        prompt: Please make an email to my wife about the groceries she needs to pick up. She can use the red car. The keys are in the pantry.
        steps: Let's identify step by step what we need to do.
        1. Address the recipient "wife"
        - example: Hello Wife,
        Today is 6-7-23.
        2. Identify the purpose of your email
        - example: I am writing to remind you to pick up the groceries you need. You can use the red car, the keys are in the pantry. We need milk.
        3. Check if the sender has specified relevant information about the groceries.
        - example: The sender needs milk.
        4. Closing line
        I hope this is helpful.
        Best wishes,
        Babe
        [email]
        Hello Wife,
        Today is 6-7-23. I am writing to remind you to pick up the groceries you need. You can use the red car, the keys are in the pantry. Remember we are out of milk.
        Best wishes,
        Babe
    - name: input
      kind: input
      text: |
        prompt: {{$input}}
        steps: Let's identify step by step what we need to do.
      default: |
        Missing parameters prevented this section from resolving.
  settings:
    temperature: 0.9
    maxTokens: 1000
