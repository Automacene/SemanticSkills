apiVersion: skills.automacene.org/v1alpha1
kind: SemanticSkill
metadata:
  name: excuses
  namespace: fun
  labels:
    automacene.org/version: "1.0.0"
  annotations:
    automacene.org/oasf-name: Creative Excuse Generator
    automacene.org/description: Turn a scenario into a creative or humorous excuse.
spec:
  authors:
    - Microsoft Semantic Kernel <https://github.com/microsoft/semantic-kernel>
    - Codie Petersen <codie@asteres-technologies.com>
  capabilities:
    skills:
      - name: language_processing/language_generation/creative_writing_generation
        id: 10308
  inputs:
    - name: input
      description: The event for which an excuse is needed.
      required: true
  sections:
    - name: instructions
      kind: instructions
      text: |-
        Generate a creative reason or excuse for the given event. Be creative and be funny. Let your
        imagination run wild.
    - name: examples
      kind: examples
      text: |-
        Event:I am running late.
        Excuse:I was being held ransom by giraffe gangsters.
    - name: input
      kind: input
      text: |-
        Event:{{$input}}
  settings:
    temperature: 0.5
    maxTokens: 60
