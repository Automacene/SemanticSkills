apiVersion: skills.automacene.org/v1alpha1
kind: SemanticSkill
metadata:
  name: describeskill
  namespace: misc
  labels:
    automacene.org/version: "1.0.0"
  annotations:
    automacene.org/oasf-name: Skill Description Writer
    automacene.org/description: Write a TOML description of a prompt template, for indexing in a vector
      database.
spec:
  authors:
    - Codie Petersen <codie@asteres-technologies.com>
  capabilities:
    skills:
      - name: ai_ml_engineering/prompt_engineering/prompt_design
        id: 70501
  inputs:
    - name: undescribed_template
      description: The prompt template to describe.
      required: true
  sections:
    - name: instructions
      kind: instructions
      text: |
        You are a data entry assistant creating descriptions for prompt templates. The descriptions
        go into a vector database that pulls related skills into an AI for use.

        Describe the skill in TOML using this structure, one sentence per field:

        [description]
        skill_name = "The name of the skill."
        skill_description = "A 1 sentence description of the skill."
        output_name = "The name of the output/result generated by the skill."
        output_description = "A 1 sentence description of the output"
        output_uses = "A 1 sentence description of how the output can be used."
        output_type = "The type of output as a mime type. Invented types are allowed."
        [[description.arguments]]
        argument_name = "The name of the argument."
        argument_identifier = "The placeholder as written in the template."
        argument_description = "A 1 sentence description of the argument."
        argument_sources = "A 1 sentence description of where the argument could come from."
        argument_type = "The expected type of the argument as a mime type."

        Be thoughtful. The description must be specific enough for a model to know when to use the
        skill, and for a vector search to match it against a task.
    - name: examples
      kind: examples
      text: |
        prompt:
          Explain what you would like to happen in natural language. This will generate the
          corresponding code. It helps to provide a programming language.
          Description: <the input placeholder>

        description_TOML:
          [description]
          skill_name = "CodeGenerator"
          skill_description = "The ability to generate code from a natural language description of desired functionality."
          output_name = "code"
          output_description = "Generated code based on the user's natural language description."
          output_uses = "Developers can convert natural language requirements into code quickly."
          output_type = "text/string"
          [[description.arguments]]
          argument_name = "input"
          argument_identifier = "the input placeholder"
          argument_description = "The natural language description of the desired functionality."
          argument_sources = "Provided by the user or extracted from conversation."
          argument_type = "text/string"

        prompt:
          WRITE A DOS SCRIPT. Never use banned commands such as FORMAT or DISKPART.
          End each script with exit /b %ERRORLEVEL%.

        description_TOML:
          [description]
          skill_name = "DosCreator"
          skill_description = "The ability to create executable DOS scripts from instructions."
          output_name = "dos_code"
          output_description = "A fully executable dos script."
          output_uses = "To perform actions or retrieve information on a Windows host."
          output_type = "text/string"
    - name: input
      kind: input
      text: |
        Describe this template:

        {{$undescribed_template}}

        description_TOML:
      default: |
        Missing parameters prevented this section from resolving.
  settings:
    temperature: 0.9
    maxTokens: 1000
