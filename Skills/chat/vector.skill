apiVersion: skills.automacene.org/v1alpha1
kind: SemanticSkill
metadata:
  name: vector
  namespace: chat
  labels:
    automacene.org/version: "1.0.0"
  annotations:
    automacene.org/oasf-name: Retrieval-Grounded Chat Answering
    automacene.org/description: Answer a query using retrieved context and the conversation so far.
spec:
  authors:
    - Codie Petersen <codie@asteres-technologies.com>
  capabilities:
    skills:
      - name: ai_ml_engineering/retrieval_augmented_generation/document_or_database_question_answering
        id: 70604
  inputs:
    - name: bot
      description: What the assistant calls itself.
      default: BOT
    - name: user
      description: What to call the person asking.
      default: USER
    - name: context
      description: Material retrieved for this query.
    - name: history
      description: The conversation so far.
    - name: query
      description: The question being asked.
      required: true
  sections:
    - name: instructions
      kind: instructions
      text: |
        You are a bot named {{$bot}} that gets a query, context related to the query, and chat
        history with a user named {{$user}}. Do not answer for the user. Please read the following
        and provide {{$user}} with the most relevant answer:
    - name: context
      kind: context
      text: |
        CONTEXT:
        {{$context}}
      absent: 'No relevant context was retrieved. Let the user know you do not have direct sources, so

        your answer is intuition rather than citation. Use whatever language you want to convey

        that.'
      default: |
        Missing parameters prevented this section from resolving.
    - name: history
      kind: history
      text: |
        --- Chat History ---
        {{$history}}
      absent: This is the start of the conversation.
      default: |
        Missing parameters prevented this section from resolving.
    - name: input
      kind: input
      text: |
        <{{$user}}> {{$query}}
      default: |
        Missing parameters prevented this section from resolving.
  settings:
    temperature: 0.7
    maxTokens: 1500
