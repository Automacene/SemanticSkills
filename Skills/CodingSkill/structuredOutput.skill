name: structuredOutput
description: "Extract structured profile data from LinkedIn or resume text"
skill_class: semantic
skill: |
  Extract important profile information from the following text. Focus on extracting the person's name, job title, company, skills, and years of experience.

  Text: {{$profile_text}}
inputs:
  - name: profile_text
    type: text
    description: "The LinkedIn or resume text to extract profile data from"
    default: ""
    required: True
schema:
  name: "string"
  job_title: "string"
  company: "string"
  skills: ["string", "string", "..."]
  years_experience: "integer"
settings:
  model: gemini-pro
  project: testvertex-405920
  location: us-west4
  stream: false
  max_tokens: 1500
  temperature: 0.7
  top_p: 1
  presence_penalty: 0
  frequency_penalty: 0