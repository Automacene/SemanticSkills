description: Extract structured profile data from LinkedIn or resume text
inputs:
- default: ''
  description: The LinkedIn or resume text to extract profile data from
  name: profile_text
  required: true
  type: text
name: structuredOutput
output:
  company: string
  job_title: string
  name: string
  skills:
  - string
  - string
  - '...'
  years_experience: integer
settings:
  frequency_penalty: 0
  location: us-west4
  max_tokens: 1500
  model: gemini-pro
  presence_penalty: 0
  project: testvertex-405920
  stream: false
  temperature: 0.7
  top_p: 1
skill: 'Extract important profile information from the following text. Focus on extracting
  the person''s name, job title, company, skills, and years of experience. Ensure you ONLY output JSON.
  Also, if you are unsure about a value, use null for strings and -1 for integers.


  Text: {{$profile_text}}

  '
skill_class: semantic
