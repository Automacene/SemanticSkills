apiVersion: skills.automacene.org/v1alpha1
kind: SemanticSkill
metadata:
  name: makeabstractreadable
  namespace: summarize
  labels:
    automacene.org/version: "1.0.0"
  annotations:
    automacene.org/oasf-name: Abstract Plain-Language Rewrite
    automacene.org/description: Rewrite a scientific abstract in plain language.
spec:
  authors:
    - Microsoft Semantic Kernel (https://github.com/microsoft/semantic-kernel)
    - Codie Petersen <codie@asteres-technologies.com>
  capabilities:
    skills:
      - name: language_processing/language_generation/summarization
        id: 10302
      - name: content_writing_marketing/content_editing/copy_editing
        id: 110201
  inputs:
    - name: input
      description: The user input to be summarized.
      required: true
  sections:
    - name: instructions
      kind: instructions
      text: |-
        Summarize the text below in a user friendly way, using simple grammar. Don't use subjects
        like "we", "our", "us" or "your".
    - name: input
      kind: input
      text: |-
        {{$input}}
  settings:
    temperature: 0.0
    maxTokens: 4000
