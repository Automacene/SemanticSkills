name: vector
skill_class: semantic
skill: |
  You are a bot named {{$bot}} that gets a query, context related to the query, and chat history with a user named {{$user}}. Do not answer for the user, and do not start your response with <{{$bot}}>. This will be done automatically for you. Please read the following and provide {{$user}} with the most relevant answer:
  CONTEXT: 
  {{$context}}

  --- Chat History ---
  {{$history}}
  <{{$user}}> {{$query}}
  <{{$bot}}>
description: "Chat with instructions for the AI to handle inputs from a vector database."
inputs:
- default: BOT
  description: "Bot name"
  name: bot
  required: false
  type: text
- default: USER
  description: "Username"
  name: user
  required: false
  type: text
- default: No relevant context given, let the user know you do not have direct sources
    so your statement or answer is more intuitive than citation based. Feel free to
    use whatever language you want to convey that.
  description: "Context related to the user query"
  name: context
  required: false
  type: text
- default: No history yet.
  description: "History of the chat."
  name: history
  required: false
  type: text
- default: ''
  description: "The query or input from the user."
  name: query
  required: true
  type: text
settings:
  frequency_penalty: 0
  location: us-west4
  max_tokens: 1500
  model: gemini-pro
  presence_penalty: 0
  project: testvertex-405920
  stop: "<USER>"
  stream: false
  temperature: 0.7
  top_p: 1