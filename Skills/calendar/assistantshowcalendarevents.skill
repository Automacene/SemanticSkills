apiVersion: skills.automacene.org/v1alpha1
kind: SemanticSkill
metadata:
  name: assistantshowcalendarevents
  namespace: calendar
  labels:
    automacene.org/version: "1.0.0"
  annotations:
    automacene.org/oasf-name: Calendar Event Query Builder
    automacene.org/description: Turn a question about a schedule into a CalendarEvents API call.
spec:
  authors:
    - Microsoft Semantic Kernel (https://github.com/microsoft/semantic-kernel)
    - Codie Petersen <codie@asteres-technologies.com>
  capabilities:
    skills:
      - name: research_knowledge_productivity/office_productivity/calendar_scheduling
        id: 130605
  inputs:
    - name: context
      description: The context of the query, such as the type of events to be listed.
      required: true
    - name: input
      description: The time frame for which the events should be listed.
      required: true
  sections:
    - name: instructions
      kind: instructions
      text: |
        API for listing CalendarEvents
        +++API
        CalendarEvents
        Print list of events in a period of time.
        Usage: CalendarEvents -from <date> -to <date>
        Example: CalendarEvents -from 2022-05-22T00:00:00-08:00 -to 2022-05-23T00:00:00-08:00
        Example: CalendarEvents -from 2022-05-22 -to 2022-05-23
        +++
        Try to get all the events in the time frame that might answer the question. E.g. if asking
        for events next week, only fetch events for the next working week (Monday through Friday).
        If asking when the next holiday is, fetch events for a month or two out.
    - name: context
      kind: context
      text: |
        {{$context}}
      default: |
        No calendar context was supplied. Work from the question alone.
    - name: question
      kind: input
      text: |
        {{$input}}

        API Call:
      default: |
        Missing parameters prevented this section from resolving.
  settings:
    temperature: 0.2
    maxTokens: 100
