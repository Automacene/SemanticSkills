apiVersion: skills.automacene.org/v1alpha1
kind: SemanticSkill
metadata:
  name: importance
  namespace: classification
  labels:
    automacene.org/version: "1.0.0"
  annotations:
    automacene.org/oasf-name: Message Importance Classifier
    automacene.org/description: Rate how urgent a message is, from its tone, content and time sensitivity.
spec:
  authors:
    - Microsoft Semantic Kernel (https://github.com/microsoft/semantic-kernel)
    - Codie Petersen <codie@asteres-technologies.com>
  capabilities:
    skills:
      - name: language_processing/text_classification/topic_labeling
        id: 10202
  inputs:
    - name: highTopics
      description: A list of topics that are considered high importance.
      required: true
    - name: lowTopics
      description: A list of topics that are considered low importance.
      required: true
    - name: input
      description: The message to be evaluated for importance.
      required: true
  sections:
    - name: instructions
      kind: instructions
      text: |
        Please decide a message's typical importance level from its tone, context, content and time
        sensitivity.

        Time sensitivity is important. Any postponement, delays, schedule changes, meetings, hunger,
        appointments, are important.

        Use one of the following importance levels. Only emit levels, nothing else:
        Importance Levels: urgent, high, medium, low
    - name: high-topics
      kind: context
      text: |
        Topics of high importance: {{$highTopics}}
      default: |
        No high-importance topics were given.
    - name: low-topics
      kind: context
      text: |
        Topics of low importance: {{$lowTopics}}
      default: |
        No low-importance topics were given.
    - name: examples
      kind: examples
      text: |
        Message: Your flight is going to be delayed! Please check your Delta app for updated schedules
        Importance: Urgent

        Message: Your daughter was just taken to the emergency room. Please call us back immediately.
        Importance: Urgent

        Message: Hey how are you? We should get lunch sometime.
        Importance: Low

        Message: What is the project status? Please send it to me today.
        Importance: High

        Message: Liverpool is now leading in their game vs Aston Villa.
        Importance: Medium
    - name: input
      kind: input
      text: |
        Message: "{{$input}}"
        Importance:
      default: |
        Missing parameters prevented this section from resolving.
  settings:
    temperature: 0.0
    maxTokens: 64
